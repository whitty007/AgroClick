PORT=3000
OTP_DEMO_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# PostgreSQL Database connection
# For Supabase, set DATABASE_URL to its PostgreSQL connection string and include sslmode=require.
# Leave it as-is for local PostgreSQL; DATABASE_URL takes precedence over the PG* settings.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agroclick
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=agroclick

# AI Chatbot API Configuration (Gemini / OpenAI / Groq)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Voice confirmation password used before checkout and final transactions
VOICE_CONFIRM_PASSWORD=1234
