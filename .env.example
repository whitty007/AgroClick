PORT=3000
OTP_DEMO_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# PostgreSQL / Supabase connection
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler.
# Paste the complete URI here. Keep credentials private and URL-encode special characters in the password.
DATABASE_URL=PASTE_SUPABASE_SESSION_POOLER_URI_HERE

# Optional alternative for a direct/local PostgreSQL connection when DATABASE_URL is empty:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_database_password
# PGDATABASE=agroclick

# AI Chatbot API Configuration (Gemini / OpenAI / Groq)
GEMINI_API_KEY=
# Voice and chatbot answers use this Gemini model first, then try built-in fallbacks.
GEMINI_CHAT_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
GROQ_API_KEY=

# Voice confirmation password used before checkout and final transactions
VOICE_CONFIRM_PASSWORD=1234
